<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Guide" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#07090E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- System splash (Android 12 SplashScreen API, backported): the icon on ink, then the Compose intro. -->
    <style name="Theme.Guide.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07090E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Guide</item>
    </style>
</resources>
